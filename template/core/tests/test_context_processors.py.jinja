from unittest import mock

from django.test import RequestFactory, SimpleTestCase, override_settings

from core.context_processors import metadata


@mock.patch("core.context_processors.__version__", "1.2.3-test")
class MetadataContextProcessorTest(SimpleTestCase):
    def setUp(self):
        self.request = RequestFactory().get("/")
        self.project_key = "{{project_name}}"

    @override_settings(COMMIT_SHA="abc123")
    def test_metadata_returns_version_and_commit(self):
        self.assertEqual(
            metadata(self.request),
            {
                self.project_key: {
                    "meta": {"version": "1.2.3-test", "commit_sha": "abc123"}
                }
            },
        )

    @override_settings(COMMIT_SHA="")
    def test_metadata_without_commit(self):
        result = metadata(self.request)[self.project_key]["meta"]["commit_sha"]
        self.assertEqual(result, "")
