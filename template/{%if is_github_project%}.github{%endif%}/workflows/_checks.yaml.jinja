# Run checks and test suite. Intended to be run ahead of building / containerising the app.
#
# Usage:
# ```
# jobs:
#   checks:
#     uses: ./.github/workflows/_checks.yaml
#     with:
#       django_checks_deploy: false | true
# ```
name: Pre-build checks

on:
  workflow_call:
    inputs:
      django_checks_deploy:
          description: 'Run checks in deploy mode'
          type: boolean
          default: false
          required: false

jobs:
  pre_commit:
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: ./.github/actions/prek

  generate-nox-sessions:
    runs-on: ubuntu-26.04
    outputs:
      session: {% raw %}${{ steps.set-matrix.outputs.session }}{% endraw +%}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - name: Cache nox session list
        id: cache-sessions
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
        with:
          path: .nox-sessions.json
          key: {% raw %}nox-sessions-${{ runner.os }}-${{ hashFiles('noxfile.py', 'pyproject.toml') }}{% endraw +%}
      - uses: wntrblm/nox@57f9e10c4eef84277dcd692d0056420c947674f9 # 2026.08.10
        if: steps.cache-sessions.outputs.cache-hit != 'true'
      - id: set-matrix
        shell: bash
        env:
          CACHE_SESSIONS_HIT: {% raw %}${{ steps.cache-sessions.outputs.cache-hit }}{% endraw +%}
        run: |
          if [[ $CACHE_SESSIONS_HIT == "true" ]]; then
            sessions_json="$(cat .nox-sessions.json)"
          else
            sessions_json="$(
              nox --list \
                | grep -E '^[*-] ' \
                | cut -d' ' -f2 \
                | jq -R -s -c 'split("\n")[:-1]'
            )"
            echo "$sessions_json" > .nox-sessions.json
          fi
          echo "session=$sessions_json" >> "$GITHUB_OUTPUT"

  test:
    needs:
      - pre_commit
      - generate-nox-sessions
    strategy:
      fail-fast: false
      matrix:
        session: {% raw %}${{ fromJson(needs.generate-nox-sessions.outputs.session) }}{% endraw +%}
    runs-on: ubuntu-26.04
    services:
      postgres:
        image: postgres:18
        env:
          POSTGRES_DB: test_{{ project_name }}
          POSTGRES_USER: test_{{ project_name }}
          POSTGRES_PASSWORD: password
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          version: "0.12.9"
          enable-cache: true
      - uses: wntrblm/nox@57f9e10c4eef84277dcd692d0056420c947674f9 # 2026.08.10
      - run: nox --session {% raw %}"${{ matrix.session }}"{% endraw +%}

  django:
    needs: pre_commit
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: ./.github/actions/django-checks
        with:
          deploy: {% raw %}${{ inputs.django_checks_deploy }}{% endraw +%}
