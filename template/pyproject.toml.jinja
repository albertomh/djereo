# https://packaging.python.org/en/latest/guides/writing-pyproject-toml/
[project]
name = "{{project_name}}"
version = "{{initial_version}}"
description = ""
authors = [
    {name = "{{author_name}}", email = "{{author_email}}"}
]
readme = "README.md"
# create 'LICENSE' file and uncomment below line
# license-files = ["LICENSE"]
requires-python = ">={{min_python_version}}"
{% set django_ver_parts = django_version.split('.') %}
{% set django_ver_major = django_ver_parts[0] | int %}
dependencies = [
    "django-alive>=2.0.0,<3.0.0",
    "django>={{django_version}},<{{django_ver_major}}.{{django_ver_parts[1] | int + 1}}",
    {% if django_ver_major < 6 %}
    "django-csp>=4.0,<5.0",
    {% endif %}
    "django-allauth>=65.19.1,<66.0.0",
    {% if use_htmx %}
    "django-htmx>=1.29.0,<2.0.0",
    {% endif %}
    "django-linear-migrations>=2.19.0,<3.0.0",
    "django-permissions-policy>=4.33.0,<5.0.0",
    "django-structlog>=10.1.0,<11.0.0",
    "django-version-checks>=1.16.0,<2.0.0",
    {% if use_django_waffle %}
    "django-waffle>=5.0.0,<6.0.0",
    {% endif %}
    "environs[django]>=15.2.0,<16.0.0",
    "gunicorn>=26.2.0,<27.0.0",
    "psycopg[binary]>=3.3.4,<4.0.0",
    "psycopg-pool>=3.3.1,<4.0.0",
    "whitenoise[brotli]>=6.12.0,<7.0.0",
]

[build-system]
requires = ["uv_build>=0.12.9,<0.13.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-root = ""
module-name = "{{project_name}}"

[dependency-groups]
test = [
    "axe-playwright-python>=0.1.8,<1.0.0",
    {% if use_htmx %}
    "beautifulsoup4>=4.15.0,<5.0.0",
    {% endif %}
    "coverage>=7.16.0,<8.0.0",
    "factory-boy>=3.3.3,<4.0.0",
    "parameterized>=0.9.0,<1.0.0",
    "playwright>=1.62.0,<2.0.0",
    "pytest-playwright>=0.9.0,<1.0.0",
    "pytest>=9.1.1,<10.0.0",
    "requests>=2.34.2,<3.0.0",
    "responses>=0.26.3,<0.27.0",
    "tblib>=3.2.2,<4.0.0",
]
dev = [
    "django-browser-reload>=1.21.0",
    "django-debug-toolbar>=7.1.1,<8.0.0",
    "ipdb>=0.13.13,<1.0.0",
    "ipython>=9.17.0,<10.0.0",
    "rich>=15.0.0,<16.0.0",
]
{% if is_github_project %}

[project.urls]
Repository = "https://github.com"
{% endif %}

[tool.uv]
exclude-newer = "7 days"

[tool.uv.exclude-newer-package]
django = false

[tool.mypy]
python_version = {{min_python_version}}

[[tool.mypy.overrides]]
module = "requests.*"
ignore_missing_imports = true

[tool.ruff]
exclude = [".pdbrc"]
indent-width = 4
line-length = 90

[tool.ruff.lint]
ignore = []
select = [
    # flake8-bugbear
    "B",
    # pycodestyle errors
    "E",
    # isort
    "I",
    # flake8-no-pep420
    "INP",
    # Pyflakes
    "F",
    #flake8-logging-format
    "G",
    # flake8-logging
    "LOG",
    # pylint-pl
    "PL",
    # ruff-specific-rules-ruf
    "RUF",
    # flake8-bandit
    "S",
    # flake8-tidy-imports
    "TID",
    # tryceratops-try
    "TRY",
    # flake8-print
    "T20",
    # pyupgrade-up
    "UP",
    # pycodestyle warnings
    "W",
]

[tool.ruff.lint.isort]
known-first-party = ["{{project_name}}", "users", "core"]

[tool.ruff.lint.per-file-ignores]
"_db/**.py" = ["INP001", "T201"]
"tests/**.py" = [
    "S",
    # import-outside-top-level
    "PLC0415",
    # too-many-arguments
    "PLR0913",
    # too-many-positional-arguments | needed for fixtures
    "PLR0917",
]
"tests_e2e/**.py" = ["S"]
"**/tests/**.py" = ["S"]
"**/migrations/**.py" = ["RUF"]
"manage.py" = ["E501"]
"noxfile.py" = ["INP001", "S"]
"{{project_name}}/settings.py" = ["E501"]
"{{project_name}}/asgi.py" = ["E501"]
"{{project_name}}/wsgi.py" = ["E501"]

[tool.ruff.lint.flake8-tidy-imports.banned-api]
"{{project_name}}.settings".msg = "Do not import project settings module - use `from django.conf import settings` instead"

[tool.pytest]
markers = [
    "axe",
]

[tool.coverage.report]
omit = [
    "*/__init__.py",
    "*/migrations/*",
    "noxfile.py",
    "*/tests/*",
    "*/tests_e2e/*",
]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "def __str__",
    "if settings.debug",
    "if settings.ENABLE_DEBUG_TOOLS",
    "if TYPE_CHECKING",
]

[tool.coverage.run]
source = ["."]
omit = [
    "manage.py",
    "*/tests/*",
    "{{project_name}}/asgi.py",
    "{{project_name}}/wsgi.py",
    "{{project_name}}/settings.py",
    "{{project_name}}/test.py",
]
parallel = true
concurrency = ["multiprocessing"]
